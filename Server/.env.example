# ==============================================================================
# Lord Diagnostics / Medora Server Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Cloud PostgreSQL (Supabase Free Tier / Neon Free Tier)
# Supabase connection string format (direct or transaction pooler):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option B: Local SQLite fallback
# Leave DATABASE_URL empty or unset, and Medora will automatically use:
# data/patient/patient_records.db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Reports & Scanned Documents)
# ------------------------------------------------------------------------------
# Free Tier: 1 GB storage, 2 GB egress / month.
# When provided, all uploaded patient reports (PDFs, JPGs, PNGs) are stored in
# the persistent Supabase Storage bucket instead of local ephemeral disk.
# If omitted, uploads automatically fall back to Server/data/patient/uploads/.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=patient-reports

# ------------------------------------------------------------------------------
# 3. AI & LLM PROVIDER (Groq Free Tier)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
HF_TOKEN=hf_your_huggingface_token_here

# ------------------------------------------------------------------------------
# 4. PATIENT PROCESSING & OCR
# ------------------------------------------------------------------------------
PATIENT_MAX_UPLOAD_MB=20
PATIENT_OCR_PROVIDER=pymupdf
PATIENT_PROCESSING_TIMEOUT=120

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME & SECURITY
# ------------------------------------------------------------------------------
PORT=8080
# Comma-separated list of additional allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
