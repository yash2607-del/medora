# ==============================================================================
# Healthcare & Diagnostic Data (Prevent Data Leakage)
# ==============================================================================
# Ignore runtime and patient data directories
data/patient/
**/data/patient/
Server/data/patient/
Server/data/history/
Server/data/csv/

# Allow reference catalog files needed for RAG
!Server/data/excel/
!Server/data/excel/*.xlsx
!Server/data/pdf/
!Server/data/pdf/*.pdf

# Raw dataset files
*.xls
*.csv
*.tsv
*.doc
*.docx

# Vector Database & Embeddings Storage (ChromaDB / SQLite / Indexes)
*.db
*.sqlite
*.sqlite3
*.bin
*.pickle
*.pkl

# Allow pre-built ChromaDB reference index for deployment
!Server/data/chroma/
!Server/data/chroma/**
!Server/data/chroma/*.sqlite3

# Conversation history, test sessions, and chat logs
Server/data/history/
*.session.json

# ==============================================================================
# Environment & Sensitive Credentials (Prevent Credential Leakage)
# ==============================================================================
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
credentials.json
client_secret*.json

# ==============================================================================
# Python & Cache Files
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Node & Frontend Build (Client)
# ==============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
client/dist/
dist/
dist-ssr/
*.local

# ==============================================================================
# Logs & Temporary Files
# ==============================================================================
*.log
logs/
*.tmp
*.temp
.cache/

# ==============================================================================
# IDE & Operating System Files
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
